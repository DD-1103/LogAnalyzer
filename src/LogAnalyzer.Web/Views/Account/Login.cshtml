@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

@section Head {
    <link rel="stylesheet" href="~/css/views-a.css" asp-append-version="true" />
}

<div class="lg-auth">
    <div class="card lg-auth-card">
        <div class="text-center mb-4">
            <span class="lg-brandmark lg-brandmark-lg mb-3" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
            <h1 class="lg-auth-title">Sign in to LogAnalyzer</h1>
            <p class="lg-auth-subtitle">Find attacks in your web server and firewall logs.</p>
        </div>

        @if (SessionSlots.Current(Context) is > 0 and var slot)
        {
            <div class="alert alert-info small py-2 lg-session-hint" role="note">
                <i class="bi bi-window-stack" aria-hidden="true"></i>
                <div>You are signing in a separate session (session @slot). Your other tabs stay signed in.</div>
            </div>
        }
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="lg-input-icon">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="lg-input-icon">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in
            </button>
        </form>

        <p class="lg-auth-note">Accounts are created by an administrator.</p>
    </div>
</div>
