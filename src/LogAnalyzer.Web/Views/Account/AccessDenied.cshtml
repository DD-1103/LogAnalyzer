@{
    ViewData["Title"] = "Access denied";
}

@section Head {
    <link rel="stylesheet" href="~/css/views-a.css" asp-append-version="true" />
}

<div class="lg-auth">
    <div class="card lg-auth-card text-center">
        <span class="lg-icon lg-icon-lg lg-tint-red mx-auto mb-3" aria-hidden="true"><i class="bi bi-slash-circle"></i></span>
        <h1 class="lg-auth-title">Access denied</h1>
        <p class="lg-auth-subtitle mb-4">Your role does not allow access to this page. Ask an administrator if you need it.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary w-100">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i> Back to dashboard
        </a>
    </div>
</div>
