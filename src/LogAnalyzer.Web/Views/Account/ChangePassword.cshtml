@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div class="row">
    <div class="col-lg-5">
        <h1 class="h3 mb-3">Change password</h1>
        <form asp-action="ChangePassword" method="post" class="card"><div class="card-body">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label small"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 10 characters with upper case, lower case, a digit and a symbol.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            </div>
            <button type="submit" class="btn btn-primary">Change password</button>
        </div></form>
    </div>
</div>
