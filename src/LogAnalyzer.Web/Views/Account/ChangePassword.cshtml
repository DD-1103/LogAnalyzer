@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

@section Head {
    <link rel="stylesheet" href="~/css/views-a.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Change password</h1>
        <p class="lg-subtitle">You stay signed in on this device after the change.</p>
    </div>
</header>

@if (User.HasClaim(LogAnalyzer.Web.Services.AppUserClaimsPrincipalFactory.MustChangePasswordClaim, "true"))
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
        <div>Your password was set by an administrator. Choose your own password to continue.</div>
    </div>
}

<div class="row">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <form asp-action="ChangePassword" method="post" class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="lg-icon lg-icon-lg lg-tint-gray" aria-hidden="true"><i class="bi bi-key-fill"></i></span>
                    <div>
                        <div class="fw-semibold">@User.Identity?.Name</div>
                        <div class="small text-body-secondary">Use a password you don't use anywhere else.</div>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label small"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least 10 characters with upper case, lower case, a digit and a symbol.</div>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Change password</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
