@model List<UserRow>
@{
    ViewData["Title"] = "Users";
    var roles = (string[])ViewBag.Roles;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Users</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-person-plus"></i> New user</a>
</div>

<p class="small text-body-secondary">
    Analysts can upload logs, view everything and triage alerts. Admins can also manage rules, users, files and re-run detection.
    Accounts are disabled rather than deleted so alerts and the audit log stay attributable.
</p>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>User</th><th>Role</th><th>Status</th><th>Last login</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var u = row.User;
                <tr class="@(u.IsDisabled ? "opacity-50" : "")">
                    <td>
                        <div class="fw-semibold">@u.FullName @if (row.IsSelf) { <span class="badge text-bg-secondary">you</span> }</div>
                        <div class="small text-body-secondary">@u.Email</div>
                    </td>
                    <td>
                        @if (row.IsSelf)
                        {
                            <span class="badge text-bg-primary">@row.Role</span>
                        }
                        else
                        {
                            <form asp-action="ChangeRole" asp-route-id="@u.Id" method="post" class="d-flex gap-1">
                                <select name="role" class="form-select form-select-sm w-auto">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r" selected="@(r == row.Role)">@r</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                            </form>
                        }
                    </td>
                    <td>
                        @if (u.IsDisabled) { <span class="badge text-bg-dark border">Disabled</span> }
                        else if (row.IsLockedOut) { <span class="badge text-bg-warning">Locked out</span> }
                        else { <span class="badge text-bg-success">Active</span> }
                    </td>
                    <td class="small text-body-secondary text-nowrap">@(u.LastLoginAt is DateTime d ? Format.TimeAgo(d) : "never")</td>
                    <td class="text-nowrap">
                        @if (!row.IsSelf)
                        {
                            @if (row.IsLockedOut && !u.IsDisabled)
                            {
                                <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Unlock</button>
                                </form>
                            }
                            <form asp-action="ToggleDisabled" asp-route-id="@u.Id" method="post" class="d-inline js-confirm"
                                  data-confirm="@(u.IsDisabled ? "Enable" : "Disable") @u.Email?">
                                <button type="submit" class="btn btn-sm @(u.IsDisabled ? "btn-outline-success" : "btn-outline-danger")">
                                    @(u.IsDisabled ? "Enable" : "Disable")
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#reset-@u.Id">
                                Reset password
                            </button>
                            <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post" id="reset-@u.Id" class="collapse mt-2">
                                <div class="input-group input-group-sm">
                                    <input type="password" name="newPassword" class="form-control" placeholder="New password (10+ chars, symbol)"
                                           minlength="10" maxlength="128" autocomplete="new-password" required />
                                    <button type="submit" class="btn btn-outline-primary">Save</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-sm btn-outline-secondary">Change my password</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
