@model List<UserRow>
@{
    ViewData["Title"] = "Users";
    var roles = (string[])ViewBag.Roles;
    var active = Model.Count(r => !r.User.IsDisabled);

    static string Initials(AppUser u)
    {
        var source = string.IsNullOrWhiteSpace(u.FullName) ? (u.Email ?? "?") : u.FullName;
        var parts = source.Split([' ', '.', '@', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        var letters = parts.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        var result = string.Concat(letters);
        return result.Length == 0 ? "?" : result;
    }
}

@section Head {
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Users</h1>
        <p class="lg-subtitle">
            @active of @Model.Count accounts are active. Analysts upload logs and triage alerts; admins also manage rules,
            users and files. Accounts are disabled rather than deleted, so alerts and the audit log stay attributable.
        </p>
    </div>
    <div class="lg-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> New user</a>
    </div>
</header>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">User</th>
                <th scope="col">Role</th>
                <th scope="col">Status</th>
                <th scope="col">Last login</th>
                <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var u = row.User;
                var isAdminRow = row.Role == Roles.Admin;
                <tr class="@(u.IsDisabled ? "lg-row-off" : "")">
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <span class="lg-icon lg-icon-sm lg-avatar @(isAdminRow ? "lg-tint-indigo" : "lg-tint-blue")" aria-hidden="true">@Initials(u)</span>
                            <div class="min-w-0">
                                <div class="fw-semibold">
                                    @u.FullName
                                    @if (row.IsSelf) { <span class="badge text-bg-primary ms-1">You</span> }
                                </div>
                                <div class="small text-body-secondary text-break">@u.Email</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (row.IsSelf)
                        {
                            <span class="badge text-bg-primary">@row.Role</span>
                        }
                        else
                        {
                            <form asp-action="ChangeRole" asp-route-id="@u.Id" method="post" class="d-flex gap-1">
                                <label for="role-@u.Id" class="visually-hidden">Role of @u.Email</label>
                                <select id="role-@u.Id" name="role" class="form-select form-select-sm w-auto">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r" selected="@(r == row.Role)">@r</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                            </form>
                        }
                    </td>
                    <td>
                        @if (u.IsDisabled) { <span class="badge text-bg-dark"><i class="bi bi-slash-circle" aria-hidden="true"></i> Disabled</span> }
                        else if (row.IsLockedOut) { <span class="badge text-bg-warning"><i class="bi bi-lock-fill" aria-hidden="true"></i> Locked out</span> }
                        else { <span class="badge text-bg-success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Active</span> }
                    </td>
                    <td class="small text-body-secondary text-nowrap">@(u.LastLoginAt is DateTime d ? Format.TimeAgo(d) : "Never")</td>
                    <td class="text-end">
                        @if (!row.IsSelf)
                        {
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                @if (row.IsLockedOut && !u.IsDisabled)
                                {
                                    <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-unlock" aria-hidden="true"></i> Unlock</button>
                                    </form>
                                }
                                <form asp-action="ToggleDisabled" asp-route-id="@u.Id" method="post" class="d-inline js-confirm"
                                      data-confirm="@(u.IsDisabled ? "Enable" : "Disable") @u.Email?">
                                    <button type="submit" class="btn btn-sm @(u.IsDisabled ? "btn-outline-success" : "btn-outline-danger")">
                                        @(u.IsDisabled ? "Enable" : "Disable")
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#reset-@u.Id"
                                        aria-expanded="false" aria-controls="reset-@u.Id">
                                    <i class="bi bi-key" aria-hidden="true"></i> Reset password
                                </button>
                            </div>
                            <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post" id="reset-@u.Id" class="collapse mt-2">
                                <div class="input-group input-group-sm ms-auto lookup-form">
                                    <label for="pw-@u.Id" class="visually-hidden">New password for @u.Email</label>
                                    <input id="pw-@u.Id" type="password" name="newPassword" class="form-control" placeholder="New password (10+ characters, a symbol)"
                                           minlength="10" maxlength="128" autocomplete="new-password" required />
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-key" aria-hidden="true"></i> Change my password
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
