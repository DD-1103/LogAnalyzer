@model CreateUserModel
@{
    ViewData["Title"] = "New user";
    var roles = (string[])ViewBag.Roles;
}

@section Head {
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">New user</li>
    </ol>
</nav>

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">New user</h1>
        <p class="lg-subtitle">Create an account and give the initial password to the person over a safe channel.</p>
    </div>
</header>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <form asp-action="Create" method="post" class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="lg-icon lg-icon-lg lg-tint-indigo"><i class="bi bi-person-plus-fill" aria-hidden="true"></i></span>
                    <div>
                        <div class="fw-semibold">Account details</div>
                        <div class="small text-body-secondary">All fields are required.</div>
                    </div>
                </div>

                <div asp-validation-summary="All" class="alert alert-danger lg-validation small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label small"></label>
                        <input asp-for="FullName" class="form-control" maxlength="150" autocomplete="name" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label small"></label>
                        <select asp-for="Role" class="form-select">
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label small"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label small">Initial password</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label small"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="col-12 form-text mt-1">At least 10 characters with upper case, lower case, a digit and a symbol.</div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Create user</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
