@model CreateUserModel
@{
    ViewData["Title"] = "New user";
    var roles = (string[])ViewBag.Roles;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active">New user</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-6">
        <h1 class="h3 mb-3">New user</h1>
        <form asp-action="Create" method="post" class="card"><div class="card-body">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label small"></label>
                <input asp-for="FullName" class="form-control" maxlength="150" />
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label small"></label>
                <input asp-for="Email" class="form-control" autocomplete="off" />
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label small"></label>
                <select asp-for="Role" class="form-select">
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label small">Initial password</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 10 characters with upper case, lower case, a digit and a symbol.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus"></i> Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div></form>
    </div>
</div>
