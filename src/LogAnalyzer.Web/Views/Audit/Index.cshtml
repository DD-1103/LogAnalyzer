@model AuditViewModel
@{
    ViewData["Title"] = "Audit log";

    static string ActionBadge(string action) =>
        action.StartsWith("Login.Failed") || action.StartsWith("Login.Locked") ? "text-bg-warning"
        : action.EndsWith(".Delete") || action.StartsWith("User.Disable") ? "text-bg-danger"
        : action.StartsWith("Login.") || action == "Logout" ? "text-bg-info"
        : action.StartsWith("Rule.") || action.StartsWith("User.") ? "text-bg-primary"
        : "text-bg-secondary";
}

@section Head {
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Audit log</h1>
        <p class="lg-subtitle">Append-only record of sign-ins, uploads, deletions, rule and user changes, triage, exports and threat-intel lookups.</p>
    </div>
    <div class="lg-actions">
        <span class="lg-chip"><i class="bi bi-journal-text" aria-hidden="true"></i> @Model.TotalCount.ToString("N0") entries</span>
    </div>
</header>

<form method="get" asp-action="Index" class="lg-toolbar row g-2 align-items-center mx-0 mt-0">
    <div class="col-sm-5 col-lg-4">
        <label for="audit-user" class="visually-hidden">User contains</label>
        <input id="audit-user" name="user" value="@Model.User" class="form-control form-control-sm" placeholder="User contains…" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <label for="audit-type" class="visually-hidden">Action</label>
        <select id="audit-type" name="type" class="form-select form-select-sm js-autosubmit">
            <option value="">All actions</option>
            @foreach (var a in Model.Actions)
            {
                <option value="@a" selected="@(a == Model.Action)">@a</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
    </div>
</form>

@if (Model.Entries.Count == 0)
{
    <div class="card">
        <div class="lg-empty">
            <i class="bi bi-journal-x" aria-hidden="true"></i>
            <p class="mb-0">No entries match these filters.</p>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm small align-middle">
            <thead>
                <tr>
                    <th scope="col">Time (UTC)</th>
                    <th scope="col">User</th>
                    <th scope="col">Action</th>
                    <th scope="col">Target</th>
                    <th scope="col">Details</th>
                    <th scope="col">From</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries)
                {
                    <tr>
                        <td class="text-nowrap">@e.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="text-break">@(e.UserName ?? "—")</td>
                        <td><span class="badge @ActionBadge(e.Action)">@e.Action</span></td>
                        <td class="text-break">@e.Target</td>
                        <td class="text-break text-body-secondary">@e.Details</td>
                        <td class="font-monospace text-body-secondary">@e.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Audit log pages">
        <ul class="pagination pagination-sm flex-wrap">
            @for (var i = Math.Max(1, Model.Page - 5); i <= Math.Min(Model.TotalPages, Model.Page + 5); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-user="@Model.User" asp-route-type="@Model.Action" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
