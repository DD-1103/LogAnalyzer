@model ThreatIntelLookupViewModel
@{
    ViewData["Title"] = Model.Ip is null ? "IP lookup" : $"IP {Model.Ip}";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var anyConfigured = Model.Providers.Any(p => p.IsConfigured);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Threat intelligence</a></li>
        <li class="breadcrumb-item active">IP lookup</li>
    </ol>
</nav>

<form asp-action="Lookup" method="get" class="d-flex gap-2 mb-4 lookup-form">
    <input name="ip" value="@Model.Ip" class="form-control font-monospace" placeholder="IP address" maxlength="45" required />
    <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-search"></i> Look up</button>
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-warning">@Model.Error</div>
}
else if (Model.Ip is not null)
{
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <h1 class="h3 mb-0 font-monospace">@Model.Ip</h1>
        @if (Model.IpInfo?.CountryCode is not null)
        {
            <span>
                <span class="badge text-bg-secondary">@Model.IpInfo.CountryCode</span>
                @(string.Join(", ", new[] { Model.IpInfo.City, Model.IpInfo.CountryName }.Where(x => !string.IsNullOrEmpty(x))))
            </span>
        }
        @if (!Model.IsPublic)
        {
            <span class="badge text-bg-dark border">private / reserved</span>
        }
        <a asp-controller="Alerts" asp-action="Index" asp-route-ip="@Model.Ip" class="small">@Model.AlertCount alert(s)</a>
        <span class="small text-body-secondary">@Model.EventCount.ToString("N0") request(s) in uploaded logs</span>
        @if (anyConfigured && Model.IsPublic)
        {
            <form asp-action="Refresh" method="post" class="ms-auto">
                <input type="hidden" name="ip" value="@Model.Ip" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-arrow-repeat"></i> Look up at all providers</button>
            </form>
        }
    </div>

    <div class="row g-3">
        @foreach (var p in Model.Providers)
        {
            <div class="col-lg-4">
                <partial name="_ReputationCard" model="new ReputationCardModel(p, Model.Results.GetValueOrDefault(p.Name), Model.Ip, Model.IsPublic, returnUrl)" />
            </div>
        }
    </div>
}
