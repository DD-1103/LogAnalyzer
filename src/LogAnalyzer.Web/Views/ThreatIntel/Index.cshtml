@model ThreatIntelIndexViewModel
@{
    ViewData["Title"] = "Threat intelligence";
    var downgradedTotal = Model.Downgrades.Sum(d => d.Count);
    var configured = Model.Providers.Count(s => s.Provider.IsConfigured);

    static (string Icon, string Tint) ProviderStyle(string slug) => slug switch
    {
        "abuseipdb" => ("bi-flag-fill", "lg-tint-red"),
        "greynoise" => ("bi-broadcast", "lg-tint-teal"),
        "virustotal" => ("bi-shield-fill-check", "lg-tint-blue"),
        _ => ("bi-globe2", "lg-tint-gray")
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Threat intelligence</h1>
        <p class="lg-subtitle">
            @configured of @Model.Providers.Count providers are configured. Look up an IP address, domain or file hash at all of them at once;
            answers are cached, and private addresses and internal host names never leave this server.
        </p>
    </div>
    <div class="lg-actions">
        <form asp-action="Search" method="post" class="lg-search lg-search-sm" role="search">
            <label for="ti-q" class="visually-hidden">IP address, domain or file hash</label>
            <input id="ti-q" name="q" class="form-control form-control-sm font-monospace" placeholder="IP, domain or hash" maxlength="2048" required autocomplete="off" spellcheck="false" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Look up</button>
        </form>
    </div>
</header>

<div class="row g-3 mb-4">
    @foreach (var s in Model.Providers)
    {
        var p = s.Provider;
        var (icon, tint) = ProviderStyle(p.Slug);
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="lg-icon @tint"><i class="bi @icon" aria-hidden="true"></i></span>
                        <div class="flex-grow-1 min-w-0">
                            <h2 class="h5 mb-0">@p.Name</h2>
                            @if (p.IsConfigured)
                            {
                                <span class="badge text-bg-success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Configured</span>
                            }
                            else
                            {
                                <span class="badge text-bg-dark">No API key</span>
                            }
                        </div>
                    </div>
                    <p class="small mb-2">@p.Description</p>
                    <p class="small text-body-secondary mb-3">@p.QuotaNote Automatic lookups: up to @p.MaxPerRun IP(s) per log file.</p>
                    @if (!p.IsConfigured)
                    {
                        <div class="small text-body-secondary mb-1">Set the key in <code>src\LogAnalyzer.Web</code>, then restart the app:</div>
                        <pre class="lg-code mb-3"><code>dotnet user-secrets set "@p.ApiKeySetting" "YOUR_KEY"</code></pre>
                    }
                    <div class="d-flex flex-wrap align-items-center gap-1 mb-3">
                        <span class="small text-body-secondary me-1">Cached answers <strong class="text-body">@s.Total</strong></span>
                        @foreach (var (verdict, count) in s.Verdicts.OrderByDescending(v => v.Key))
                        {
                            <span class="badge @Format.VerdictBadge(verdict)">@verdict @count</span>
                        }
                    </div>
                    <div class="mt-auto">
                        <a asp-action="Provider" asp-route-id="@p.Slug" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-sliders" aria-hidden="true"></i> Details and test
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="lg-section-title">
                    <span class="lg-icon lg-icon-sm lg-tint-teal"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></span>
                    GreyNoise severity rule
                </h2>
                <p class="small text-body-secondary">
                    Alerts from IPs that GreyNoise classifies as <em>benign</em> (search engines, research scanners,
                    RIOT business services) are lowered one severity level. The original severity is kept for evaluation.
                </p>
                <div class="d-flex align-items-baseline gap-2 mb-3">
                    <span class="lg-big-number" data-countup>@downgradedTotal</span>
                    <span class="text-body-secondary small">of @Model.TotalAlerts.ToString("N0") alerts lowered</span>
                </div>
                @if (Model.Downgrades.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var d in Model.Downgrades)
                        {
                            <span class="lg-chip">
                                <span class="badge @Format.SeverityBadge(d.From)">@d.From</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i><span class="visually-hidden">to</span>
                                <span class="badge @Format.SeverityBadge(d.To)">@d.To</span>
                                <strong>@d.Count</strong>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="lg-section-title">
                    <span class="lg-icon lg-icon-sm lg-tint-indigo"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                    Latest lookups
                </h2>
                @if (Model.Recent.Count == 0)
                {
                    <div class="lg-empty py-3">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <p class="mb-0">No lookups yet. They appear here after a log file is analysed or an IP is looked up.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm small align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">IP</th>
                                    <th scope="col">Provider</th>
                                    <th scope="col">Verdict</th>
                                    <th scope="col">Summary</th>
                                    <th scope="col">Checked</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Recent)
                                {
                                    <tr>
                                        <td class="font-monospace"><a asp-action="Lookup" asp-route-q="@r.Ip" class="text-break">@r.Ip</a></td>
                                        <td>@r.Provider</td>
                                        <td><span class="badge @Format.VerdictBadge(r.Verdict)">@r.Verdict</span></td>
                                        <td class="summary-cell" title="@(r.Error ?? r.Summary)">@(r.Error ?? r.Summary)</td>
                                        <td class="text-body-secondary text-nowrap">@Format.TimeAgo(r.CheckedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
