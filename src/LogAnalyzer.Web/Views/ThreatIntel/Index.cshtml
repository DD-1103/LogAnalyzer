@model ThreatIntelIndexViewModel
@{
    ViewData["Title"] = "Threat intelligence";
    var downgradedTotal = Model.Downgrades.Sum(d => d.Count);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Threat intelligence</h1>
    <form asp-action="Lookup" method="get" class="d-flex gap-2">
        <input name="ip" class="form-control form-control-sm font-monospace" placeholder="IP address, e.g. 185.220.101.45" maxlength="45" required />
        <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-search"></i> Look up</button>
    </form>
</div>

<p class="text-body-secondary small">
    After each log file is analysed, the source IPs of its alerts are checked at every configured provider
    (answers are cached and lookups are limited per run to respect free quotas). Private addresses are never sent out.
    API keys are stored with <code>dotnet user-secrets</code>, never in <code>appsettings.json</code>.
</p>

<div class="row g-3 mb-4">
    @foreach (var s in Model.Providers)
    {
        var p = s.Provider;
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">@p.Name</h2>
                        @if (p.IsConfigured)
                        {
                            <span class="badge text-bg-success"><i class="bi bi-check-circle"></i> Configured</span>
                        }
                        else
                        {
                            <span class="badge text-bg-dark border">No API key</span>
                        }
                    </div>
                    <p class="small mb-2">@p.Description</p>
                    <p class="small text-body-secondary mb-2">@p.QuotaNote Automatic lookups: up to @p.MaxPerRun IP(s) per log file.</p>
                    @if (!p.IsConfigured)
                    {
                        <div class="small mb-2">
                            Set the key (in <code>src\LogAnalyzer.Web</code>), then restart the app:
                            <code class="d-block mt-1 text-break">dotnet user-secrets set "@p.ApiKeySetting" "YOUR_KEY"</code>
                        </div>
                    }
                    <div class="small mb-3">
                        <span class="text-body-secondary">Cached answers:</span> <strong>@s.Total</strong>
                        @foreach (var (verdict, count) in s.Verdicts.OrderByDescending(v => v.Key))
                        {
                            <span class="badge @Format.VerdictBadge(verdict) ms-1">@verdict @count</span>
                        }
                    </div>
                    <div class="mt-auto">
                        <a asp-action="Provider" asp-route-id="@p.Slug" class="btn btn-sm btn-outline-secondary">Details</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">GreyNoise severity rule</h2>
            <p class="small text-body-secondary">
                Alerts whose source IP GreyNoise classifies as <em>benign</em> (search engines, research scanners,
                RIOT business services) are lowered one severity level. The original severity is kept for evaluation.
            </p>
            @if (downgradedTotal == 0)
            {
                <p class="small mb-0">No alerts lowered yet (of @Model.TotalAlerts.ToString("N0") alerts).</p>
            }
            else
            {
                <p class="small"><strong>@downgradedTotal</strong> of @Model.TotalAlerts.ToString("N0") alerts lowered:</p>
                <ul class="small mb-0">
                    @foreach (var d in Model.Downgrades)
                    {
                        <li>@d.From → @d.To: @d.Count</li>
                    }
                </ul>
            }
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Latest lookups</h2>
            @if (Model.Recent.Count == 0)
            {
                <p class="small text-body-secondary mb-0">No lookups yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm small align-middle mb-0">
                        <tbody>
                            @foreach (var r in Model.Recent)
                            {
                                <tr>
                                    <td class="font-monospace"><a asp-action="Lookup" asp-route-ip="@r.Ip">@r.Ip</a></td>
                                    <td>@r.Provider</td>
                                    <td><span class="badge @Format.VerdictBadge(r.Verdict)">@r.Verdict</span></td>
                                    <td class="summary-cell" title="@(r.Error ?? r.Summary)">@(r.Error ?? r.Summary)</td>
                                    <td class="text-body-secondary text-nowrap">@Format.TimeAgo(r.CheckedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div></div>
    </div>
</div>
