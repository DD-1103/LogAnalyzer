@model ThreatIntelSearchViewModel
@{
    ViewData["Title"] = "Threat intelligence";
    var configured = Model.Providers.Count(p => p.IsConfigured);
}

@section Head {
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<section class="lg-ti-hero" aria-labelledby="ti-hero-title">
    <span class="lg-icon lg-icon-lg lg-tint-indigo lg-ti-hero-icon" aria-hidden="true"><i class="bi bi-radar"></i></span>
    <h1 id="ti-hero-title" class="lg-title">Threat intelligence</h1>
    <p class="lg-subtitle">
        Check an IP address, a domain or a file hash. @(configured == 0
            ? "No provider is configured yet: add an API key on the providers page."
            : $"{configured} of {Model.Providers.Count} providers answer at once, and LogAnalyzer combines them into one verdict.")
    </p>

    <form asp-action="Search" method="post" class="lg-panel lg-search lg-search-hero" role="search">
        <label for="ti-q" class="visually-hidden">IP address, domain or file hash</label>
        <i class="bi bi-search lg-search-icon" aria-hidden="true"></i>
        <input id="ti-q" name="q" class="form-control font-monospace" maxlength="2048" required autofocus
               placeholder="185.220.101.45, example.com or a SHA-256 hash" autocomplete="off" spellcheck="false" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Search</button>
        <p class="lg-search-hint">
            IPv4 and IPv6, domains, full URLs (the host is checked) and MD5, SHA-1 or SHA-256 hashes.
            Defanged input such as <code>example[.]com</code> works too.
        </p>
    </form>

    <ul class="lg-ti-providers" aria-label="Providers">
        @foreach (var p in Model.Providers)
        {
            var (icon, tint) = Format.VendorStyle(p.Slug);
            <li>
                <a asp-action="Provider" asp-route-id="@p.Slug" class="lg-ti-provider @(p.IsConfigured ? "is-on" : "is-off")"
                   title="@(p.IsConfigured ? $"{p.Name} is configured" : $"{p.Name}: no API key")">
                    <span class="lg-icon lg-icon-sm @tint" aria-hidden="true"><i class="bi @icon"></i></span>
                    <span>@p.Name</span>
                    <span class="lg-ti-dot" aria-hidden="true"></span>
                    <span class="visually-hidden">@(p.IsConfigured ? "(configured)" : "(no API key)")</span>
                </a>
            </li>
        }
    </ul>
    <a asp-action="Providers" class="small">Manage providers and API keys</a>
</section>

@if (Model.Recent.Count > 0)
{
    <section class="lg-ti-recent-wrap" aria-labelledby="recent-title">
        <h2 id="recent-title" class="lg-section-title">Recent lookups</h2>
        <ul class="lg-ti-recent">
            @foreach (var r in Model.Recent)
            {
                <li>
                    <a asp-action="Lookup" asp-route-q="@r.Value" class="lg-ti-recent-item">
                        <span class="lg-ti-pill tone-@Format.ConsensusTone(r.Consensus.Verdict)">@r.Consensus.Label</span>
                        <span class="font-monospace text-break lg-ti-recent-value">@r.Value</span>
                        <span class="small text-body-secondary">@(r.Kind switch { IndicatorType.Ip => "IP", IndicatorType.Domain => "Domain", _ => "Hash" }), @Format.TimeAgo(r.CheckedAt)</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}
