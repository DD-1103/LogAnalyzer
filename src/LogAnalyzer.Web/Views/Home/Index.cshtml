@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    // Default System.Text.Json encoding escapes <, >, & and quotes, so log-derived strings
    // (e.g. a crafted "IP" field) cannot close the JSON <script> block or inject markup.
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    string ToJson(object value) => JsonSerializer.Serialize(value, jsonOptions);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Dashboard</h1>
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
        <label for="logFileId" class="small text-body-secondary text-nowrap">Scope</label>
        <select id="logFileId" name="logFileId" class="form-select form-select-sm js-autosubmit">
            <option value="">All log files</option>
            @foreach (var f in Model.Files)
            {
                if (Model.LogFileId == f.Id) { <option value="@f.Id" selected>#@f.Id · @f.FileName</option> }
                else { <option value="@f.Id">#@f.Id · @f.FileName</option> }
            }
        </select>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="text-body-secondary small">Log files</div>
            <div class="fs-2 fw-semibold">@Model.LogFiles</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="text-body-secondary small">Parsed events</div>
            <div class="fs-2 fw-semibold">@Model.Events.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="text-body-secondary small">Open alerts</div>
            <div class="fs-2 fw-semibold text-danger">@Model.OpenAlerts</div>
            <div class="small text-body-secondary">@Model.OpenHighOrCritical high / critical</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="text-body-secondary small">Enabled rules</div>
            <div class="fs-2 fw-semibold">@Model.EnabledRules</div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Requests over time</h2>
            @if (Model.HourLabels.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No events yet. Upload a log file to see traffic.</p>
            }
            else
            {
                <div class="chart-box"><canvas id="chartTimeline"></canvas></div>
            }
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Alerts by severity</h2>
            <div class="chart-box"><canvas id="chartSeverity"></canvas></div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Malicious requests by attack type</h2>
            @if (Model.ByAttackType.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No alerts yet.</p>
            }
            else
            {
                <div class="chart-box"><canvas id="chartTypes"></canvas></div>
            }
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Attack origins</h2>
            @if (!Model.GeoIpAvailable)
            {
                <div class="alert alert-secondary small mb-2">
                    GeoIP is off. Put a city database (<strong>dbip-city-lite-*.mmdb</strong> from db-ip.com or
                    <strong>GeoLite2-City.mmdb</strong> from MaxMind) in <code>src/LogAnalyzer.Web/App_Data/</code>,
                    then restart and re-run detection.
                </div>
            }
            <div id="map" class="attack-map"></div>
            @if (Model.GeoIpSource == "DB-IP")
            {
                <div class="small text-body-secondary mt-1"><a href="https://db-ip.com" target="_blank" rel="noopener">IP Geolocation by DB-IP</a></div>
            }
            else if (Model.GeoIpSource is not null)
            {
                <div class="small text-body-secondary mt-1">This product includes GeoLite2 data created by MaxMind, available from <a href="https://www.maxmind.com" target="_blank" rel="noopener">maxmind.com</a>.</div>
            }
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Top attacking IPs</h2>
            @if (Model.TopIps.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No attackers detected.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle small mb-0">
                        <thead>
                            <tr>
                                <th>IP</th>
                                <th>Location</th>
                                <th>Reputation</th>
                                <th class="text-end">Malicious req.</th>
                                <th>Attacks</th>
                                <th>Max</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ip in Model.TopIps)
                            {
                                <tr>
                                    <td class="font-monospace">
                                        <a asp-controller="Alerts" asp-action="Index" asp-route-ip="@ip.Ip">@ip.Ip</a>
                                    </td>
                                    <td>
                                        @if (ip.CountryCode is not null)
                                        {
                                            <span class="badge text-bg-secondary">@ip.CountryCode</span>
                                            <span class="text-body-secondary">@(ip.City ?? ip.Country)</span>
                                        }
                                        else { <span class="text-body-secondary">—</span> }
                                    </td>
                                    <td>
                                        @if (ip.Reputation.Count == 0)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        @foreach (var r in ip.Reputation)
                                        {
                                            <a asp-controller="ThreatIntel" asp-action="Lookup" asp-route-ip="@ip.Ip"
                                               class="badge @Format.VerdictBadge(r.Verdict) text-decoration-none" title="@r.Summary">@Format.ReputationShort(r)</a>
                                        }
                                    </td>
                                    <td class="text-end">@ip.Events.ToString("N0")</td>
                                    <td>@ip.AttackTypes</td>
                                    <td><span class="badge @Format.SeverityBadge(ip.MaxSeverity)">@ip.MaxSeverity</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6">Latest alerts</h2>
            @if (Model.RecentAlerts.Count == 0)
            {
                <p class="text-body-secondary small mb-0">No alerts yet.</p>
            }
            <ul class="list-group list-group-flush small">
                @foreach (var a in Model.RecentAlerts)
                {
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <span class="badge @Format.SeverityBadge(a.Severity)">@a.Severity</span>
                        <div class="flex-grow-1">
                            <a asp-controller="Alerts" asp-action="Details" asp-route-id="@a.Id">@a.Title</a>
                            <div class="text-body-secondary">@a.LogFile?.FileName · @a.EventCount events</div>
                        </div>
                        <span class="badge @Format.AlertStatusBadge(a.Status)">@a.Status</span>
                    </li>
                }
            </ul>
        </div></div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script type="application/json" id="dashboard-data">@Html.Raw(ToJson(new
    {
        hours = Model.HourLabels,
        total = Model.HourTotal,
        malicious = Model.HourMalicious,
        severity = Model.BySeverity,
        types = Model.ByAttackType,
        points = Model.MapPoints
    }))</script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
