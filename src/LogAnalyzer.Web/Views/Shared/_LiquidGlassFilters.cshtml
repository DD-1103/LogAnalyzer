@* Liquid Glass refraction filters (iOS 26/27 style).
   Each filter displaces the backdrop near the element's edges like a glass lens: a displacement map
   (red = horizontal, green = vertical shift, 50 % grey = none) is stretched over the element; the ramps
   at the edges pull in what lies just outside, so shapes behind the glass bend around its rim.
   Used through backdrop-filter: url(#...) on Chromium browsers only (html.lg-refract, see theme-init.js).
   Maps are data: URIs (allowed by the CSP img-src) - no script involved. *@
<svg class="lg-filters" width="0" height="0" aria-hidden="true" focusable="false">
    @* Compact glass: tiles, buttons, icon buttons *@
    <filter id="lg-lens" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27100%27%20height%3D%27100%27%20preserveAspectRatio%3D%27none%27%3E%3Cdefs%3E%3ClinearGradient%20id%3D%27x%27%20x1%3D%270%27%20x2%3D%271%27%20y1%3D%270%27%20y2%3D%270%27%3E%3Cstop%20offset%3D%270%27%20stop-color%3D%27rgb%280%2C0%2C0%29%27%2F%3E%3Cstop%20offset%3D%270.18%27%20stop-color%3D%27rgb%28128%2C0%2C0%29%27%2F%3E%3Cstop%20offset%3D%270.820%27%20stop-color%3D%27rgb%28128%2C0%2C0%29%27%2F%3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27rgb%28255%2C0%2C0%29%27%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%27y%27%20x1%3D%270%27%20x2%3D%270%27%20y1%3D%270%27%20y2%3D%271%27%3E%3Cstop%20offset%3D%270%27%20stop-color%3D%27rgb%280%2C0%2C0%29%27%2F%3E%3Cstop%20offset%3D%270.24%27%20stop-color%3D%27rgb%280%2C128%2C0%29%27%2F%3E%3Cstop%20offset%3D%270.760%27%20stop-color%3D%27rgb%280%2C128%2C0%29%27%2F%3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27rgb%280%2C255%2C0%29%27%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%27100%27%20height%3D%27100%27%20fill%3D%27url%28%23x%29%27%2F%3E%3Crect%20width%3D%27100%27%20height%3D%27100%27%20fill%3D%27url%28%23y%29%27%20style%3D%27mix-blend-mode%3Ascreen%27%2F%3E%3C%2Fsvg%3E" x="0%" y="0%" width="100%" height="100%" preserveAspectRatio="none" result="map" />
