<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#edf1f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1f2d" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"] · LogAnalyzer</title>
    @* Sets the light/dark theme before first paint (external file: the CSP forbids inline scripts) *@
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(Roles.Admin);
    var controller = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;

    string NavClass(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)) ? "nav-link active" : "nav-link";
    string? Current(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
}
<body data-navcounts="@(signedIn ? Url.Action("NavCounts", "Home") : null)">
    <div class="lg-backdrop" aria-hidden="true">
        <span class="lg-blob"></span>
        <span class="lg-blob"></span>
        <span class="lg-blob"></span>
        <span class="lg-blob"></span>
    </div>

    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" href="#main">Skip to content</a>

    <header class="lg-shell">
        <nav class="navbar navbar-expand-xl lg-nav" aria-label="Main">
            <div class="container-fluid gap-2">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="lg-brandmark" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                    LogAnalyzer
                </a>

                @if (signedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                            aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="nav">
                        <ul class="navbar-nav me-auto ms-xl-3">
                            <li class="nav-item">
                                <a class="@NavClass("Home")" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-grid-1x2" aria-hidden="true"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("LogFiles")" aria-current="@Current("LogFiles")" asp-controller="LogFiles" asp-action="Index">
                                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Log files
                                    <span id="badge-files" class="badge text-bg-info d-none" title="Files being processed">
                                        <span class="spinner-border spinner-border-sm lg-nav-spinner" aria-hidden="true"></span>
                                        <span class="count"></span>
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Alerts")" aria-current="@Current("Alerts")" asp-controller="Alerts" asp-action="Index">
                                    <i class="bi bi-bell" aria-hidden="true"></i> Alerts
                                    <span id="badge-alerts" class="badge text-bg-danger d-none" title="New alerts since your last visit">
                                        <span class="count"></span>
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Rules")" aria-current="@Current("Rules")" asp-controller="Rules" asp-action="Index">
                                    <i class="bi bi-funnel" aria-hidden="true"></i> Rules
                                    <span id="badge-rules" class="badge text-bg-warning d-none" title="Rules that fired since your last visit">
                                        <span class="count"></span>
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("ThreatIntel")" aria-current="@Current("ThreatIntel")" asp-controller="ThreatIntel" asp-action="Index">
                                    <i class="bi bi-globe2" aria-hidden="true"></i> Threat intel
                                </a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="@NavClass("Users", "Audit") dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-sliders" aria-hidden="true"></i> Admin
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i> Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index"><i class="bi bi-journal-text" aria-hidden="true"></i> Audit log</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-2 lg-nav-tools">
                            <button type="button" class="lg-icon-btn js-theme-toggle" aria-label="Theme: automatic" title="Theme: automatic">
                                <i class="bi bi-sun-fill lg-theme-icon lg-theme-icon-light" aria-hidden="true"></i>
                                <i class="bi bi-moon-stars-fill lg-theme-icon lg-theme-icon-dark" aria-hidden="true"></i>
                                <i class="bi bi-circle-half lg-theme-icon lg-theme-icon-auto" aria-hidden="true"></i>
                            </button>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle lg-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity!.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-body-secondary">Signed in as @(isAdmin ? Roles.Admin : Roles.Analyst)</span></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> Change password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="lg-icon-btn js-theme-toggle ms-auto" aria-label="Theme: automatic" title="Theme: automatic">
                        <i class="bi bi-sun-fill lg-theme-icon lg-theme-icon-light" aria-hidden="true"></i>
                        <i class="bi bi-moon-stars-fill lg-theme-icon lg-theme-icon-dark" aria-hidden="true"></i>
                        <i class="bi bi-circle-half lg-theme-icon lg-theme-icon-auto" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </nav>
    </header>

    <main id="main" class="container lg-main" tabindex="-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show lg-flash" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <div>@ok</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show lg-flash" role="alert">
                <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                <div>@err</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="lg-footer">LogAnalyzer – web attack detection from server logs</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
