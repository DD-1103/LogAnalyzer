@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Options.IOptionsMonitor<Microsoft.AspNetCore.Authentication.Cookies.CookieAuthenticationOptions> CookieOptions
@{
    // Session slot of this tab (/s/1 ... /s/9, 0 = normal URLs), see SessionSlots.
    var slot = SessionSlots.Current(Context);
    var authCookie = CookieOptions.Get(Microsoft.AspNetCore.Identity.IdentityConstants.ApplicationScheme).Cookie.Name ?? "";
    var cookieNames = Context.Request.Cookies.Keys;
    var otherSlots = SessionSlots.UsedSlots(cookieNames, authCookie).Where(s => s != slot).ToList();
    var freeSlot = SessionSlots.FirstFreeSlot(cookieNames, authCookie);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#edf1f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1f2d" media="(prefers-color-scheme: dark)" />
    @* The slot comes first so tabs of different sessions can be told apart even when the title is cut off *@
    <title>@(slot > 0 ? $"[{slot}] " : null)@ViewData["Title"] · LogAnalyzer</title>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Antiforgery token for fetch() POSTs (bell); sent as the RequestVerificationToken header *@
        <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    @* Sets the light/dark theme before first paint (external file: the CSP forbids inline scripts) *@
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(Roles.Admin);
    // Navigation only; the hub itself checks the tier in the database.
    var isSoc2 = isAdmin || User.HasClaim(AppUserClaimsPrincipalFactory.TierClaim, nameof(AnalystTier.Soc2));
    var controller = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;

    string NavClass(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)) ? "nav-link active" : "nav-link";
    string? Current(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
}
<body data-navcounts="@(signedIn ? Url.Action("NavCounts", "Home") : null)">
    <div class="lg-backdrop" aria-hidden="true">
        <span class="lg-aura"></span>
        <span class="lg-aura"></span>
        <span class="lg-aura"></span>
        <span class="lg-aura"></span>
    </div>
    <partial name="_LiquidGlassFilters" />

    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" href="#main">Skip to content</a>

    <header class="lg-shell">
        <nav class="navbar navbar-expand-xl lg-nav" aria-label="Main">
            <div class="container-fluid gap-2">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="lg-brandmark" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                    LogAnalyzer
                </a>

                @if (signedIn)
                {
                    @* Bell outside the collapsible menu: the unread badge is visible on every screen size *@
                    <div class="dropdown lg-bell ms-auto ms-xl-2 order-xl-last">
                        <button type="button" class="lg-icon-btn js-bell" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                aria-expanded="false" aria-label="Notifications" title="Notifications">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span class="visually-hidden js-bell-sr"></span>
                        </button>
                        <span id="badge-bell" class="lg-bell-badge d-none" aria-hidden="true"><span class="count"></span></span>
                        <div class="dropdown-menu dropdown-menu-end lg-bell-menu"
                             data-list="@Url.Action("List", "Notifications")" data-read="@Url.Action("MarkRead", "Notifications")"
                             data-delete="@Url.Action("Delete", "Notifications")" data-clear="@Url.Action("ClearRead", "Notifications")">
                            <div class="lg-bell-head">
                                <span class="fw-semibold">Notifications</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary js-bell-clear" disabled>Clear all</button>
                            </div>
                            <ul class="lg-bell-list" aria-live="polite"></ul>
                            <a class="lg-bell-all" asp-controller="Notifications" asp-action="Index">Open all notifications</a>
                        </div>
                    </div>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                            aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="nav">
                        <ul class="navbar-nav me-auto ms-xl-3">
                            <li class="nav-item">
                                <a class="@NavClass("Home")" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-grid-1x2" aria-hidden="true"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("LogFiles")" aria-current="@Current("LogFiles")" asp-controller="LogFiles" asp-action="Index">
                                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Log files
                                    <span id="badge-files" class="badge text-bg-info d-none" title="Files being processed">
                                        <span class="spinner-border spinner-border-sm lg-nav-spinner" aria-hidden="true"></span>
                                        <span class="count"></span>
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Alerts")" aria-current="@Current("Alerts")" asp-controller="Alerts" asp-action="Index">
                                    <i class="bi bi-shield-exclamation" aria-hidden="true"></i> Alerts
                                    <span id="badge-alerts" class="badge text-bg-danger d-none" title="New alerts since your last visit">
                                        <span class="count"></span>
                                    </span>
                                </a>
                            </li>
                            @if (isSoc2)
                            {
                                <li class="nav-item">
                                    <a class="@NavClass("Soc2")" aria-current="@Current("Soc2")" asp-controller="Soc2" asp-action="Index">
                                        <i class="bi bi-inboxes" aria-hidden="true"></i> SOC 2 hub
                                        <span id="badge-soc2" class="badge text-bg-warning d-none" title="Escalations nobody has taken yet">
                                            <span class="count"></span>
                                        </span>
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="@NavClass("Rules")" aria-current="@Current("Rules")" asp-controller="Rules" asp-action="Index">
                                    <i class="bi bi-funnel" aria-hidden="true"></i> Rules
                                    <span id="badge-rules" class="badge text-bg-warning d-none" title="Rules that fired since your last visit">
                                        <span class="count"></span>
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("ThreatIntel")" aria-current="@Current("ThreatIntel")" asp-controller="ThreatIntel" asp-action="Index">
                                    <i class="bi bi-globe2" aria-hidden="true"></i> Threat intel
                                </a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="@NavClass("Users", "Audit") dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-sliders" aria-hidden="true"></i> Admin
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i> Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index"><i class="bi bi-journal-text" aria-hidden="true"></i> Audit log</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-2 lg-nav-tools">
                            @if (slot > 0)
                            {
                                <span class="lg-session-chip" title="Session @slot – this tab has its own sign-in">
                                    <i class="bi bi-window-stack" aria-hidden="true"></i><span aria-hidden="true">@slot</span><span class="visually-hidden">Session @slot</span>
                                </span>
                            }
                            <button type="button" class="lg-icon-btn js-theme-toggle" aria-label="Theme: automatic" title="Theme: automatic">
                                <i class="bi bi-sun-fill lg-theme-icon lg-theme-icon-light" aria-hidden="true"></i>
                                <i class="bi bi-moon-stars-fill lg-theme-icon lg-theme-icon-dark" aria-hidden="true"></i>
                                <i class="bi bi-circle-half lg-theme-icon lg-theme-icon-auto" aria-hidden="true"></i>
                            </button>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle lg-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@User.Identity!.Name">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i> <span class="lg-user-name">@(User.Identity!.Name?.Split('@')[0])</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-body-secondary">Signed in as <span class="fw-semibold text-break">@User.Identity!.Name</span><br />@(isAdmin ? Roles.Admin : Roles.Analyst)@(User.FindFirst(AppUserClaimsPrincipalFactory.TierClaim)?.Value is { } t && !isAdmin ? (t == nameof(AnalystTier.Soc2) ? " · SOC 2" : " · SOC 1") : "")@(slot > 0 ? $" · session {slot}" : "")</span></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> Change password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (freeSlot is not null)
                                    {
                                        <li>
                                            @* The free slot is chosen at the click (this page may be old by then) *@
                                            <a class="dropdown-item" asp-controller="Account" asp-action="NewSession"
                                               target="_blank" rel="noopener" title="Opens a new tab with its own sign-in">
                                                <i class="bi bi-person-plus" aria-hidden="true"></i> Sign in another account
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li><span class="dropdown-item-text small text-body-secondary lg-session-note">All @SessionSlots.MaxSlot extra sessions are in use. Log out in one of them to sign in another account.</span></li>
                                    }
                                    @if (otherSlots.Count > 0)
                                    {
                                        <li>
                                            <div class="dropdown-item-text small lg-session-list">
                                                <span class="text-body-secondary">Other sessions:</span>
                                                @foreach (var other in otherSlots)
                                                {
                                                    <a class="lg-chip" href="@(SessionSlots.PathBaseFor(Context, other).ToUriComponent())/" target="_blank" rel="noopener"
                                                       aria-label="Open session @(other == 0 ? "main" : other.ToString()) in a new tab">@(other == 0 ? "Main" : other.ToString())</a>
                                                }
                                            </div>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="lg-icon-btn js-theme-toggle ms-auto" aria-label="Theme: automatic" title="Theme: automatic">
                        <i class="bi bi-sun-fill lg-theme-icon lg-theme-icon-light" aria-hidden="true"></i>
                        <i class="bi bi-moon-stars-fill lg-theme-icon lg-theme-icon-dark" aria-hidden="true"></i>
                        <i class="bi bi-circle-half lg-theme-icon lg-theme-icon-auto" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </nav>
    </header>

    <main id="main" class="container lg-main" tabindex="-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show lg-flash" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <div>@ok</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show lg-flash" role="alert">
                <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                <div>@err</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="lg-footer">LogAnalyzer – attack detection from web server and firewall logs</footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
