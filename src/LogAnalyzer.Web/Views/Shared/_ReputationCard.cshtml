@* One provider's cached answer about an IP, with Look up / Refresh and a link to the vendor's page. *@
@model ReputationCardModel
@{
    var p = Model.Provider;
    var r = Model.Result;
}
<div class="card h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <div>
                <h3 class="h6 mb-0">
                    <a asp-controller="ThreatIntel" asp-action="Provider" asp-route-id="@p.Slug" class="text-reset">@p.Name</a>
                </h3>
                @if (r is not null)
                {
                    <div class="small text-body-secondary" title="@r.CheckedAt.ToString("u")">checked @Format.TimeAgo(r.CheckedAt)</div>
                }
            </div>
            @if (r is not null)
            {
                <span class="badge @Format.VerdictBadge(r.Verdict)">@r.Verdict</span>
            }
            else if (!p.IsConfigured)
            {
                <span class="badge text-bg-dark border">No API key</span>
            }
        </div>

        @if (r is null)
        {
            <p class="small text-body-secondary mb-2">
                @if (!p.IsConfigured)
                {
                    <span>Add a key to see data: <code>dotnet user-secrets set "@p.ApiKeySetting" "KEY"</code></span>
                }
                else if (!Model.IsPublic)
                {
                    <span>Private / reserved address – never sent to external services.</span>
                }
                else
                {
                    <span>Not looked up yet.</span>
                }
            </p>
        }
        else
        {
            <p class="small mb-2">@r.Summary</p>
            var attributes = r.GetAttributes();
            if (attributes.Count > 0)
            {
                <dl class="row small mb-2">
                    @foreach (var (key, value) in attributes)
                    {
                        <dt class="col-6 fw-normal text-body-secondary">@key</dt>
                        <dd class="col-6 mb-1 text-break">@value</dd>
                    }
                </dl>
            }
        }

        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (p.IsConfigured && Model.IsPublic)
            {
                <form asp-controller="ThreatIntel" asp-action="Refresh" method="post" class="d-inline">
                    <input type="hidden" name="ip" value="@Model.Ip" />
                    <input type="hidden" name="provider" value="@p.Slug" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrow-repeat"></i> @(r is null ? "Look up" : "Refresh")
                    </button>
                </form>
            }
            @if (Model.IsPublic)
            {
                <a href="@p.WebLink(Model.Ip)" target="_blank" rel="noopener noreferrer" class="small">
                    open on @p.Name <i class="bi bi-box-arrow-up-right"></i>
                </a>
            }
        </div>
    </div>
</div>
