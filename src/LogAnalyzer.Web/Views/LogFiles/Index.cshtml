@model List<LogFile>
@{
    ViewData["Title"] = "Log files";
    var busy = Model.Any(f => Format.IsBusy(f.Status));
    var isAdmin = User.IsInRole(Roles.Admin);

    string FileTint(LogFileStatus s) => s switch
    {
        LogFileStatus.Completed => "lg-tint-green",
        LogFileStatus.Failed => "lg-tint-red",
        LogFileStatus.Deleting => "lg-tint-gray",
        _ => "lg-tint-blue"
    };
    string FileIcon(LogFileStatus s) => s switch
    {
        LogFileStatus.Completed => "bi-file-earmark-check",
        LogFileStatus.Failed => "bi-file-earmark-x",
        LogFileStatus.Deleting => "bi-trash",
        _ => "bi-hourglass-split"
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/views-b.css" asp-append-version="true" />
}
@if (busy)
{
    @* Refresh while files are still being processed *@
    <meta http-equiv="refresh" content="3" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Log files</h1>
        <p class="lg-subtitle">
            @if (Model.Count == 0)
            {
                <span>Upload a web server or firewall log to parse it and run the detection rules.</span>
            }
            else
            {
                <span>@Model.Count uploaded @(Model.Count == 1 ? "file" : "files"), newest first.</span>
                @if (busy)
                {
                    <span>This page refreshes while files are processed.</span>
                }
            }
        </p>
    </div>
    <div class="lg-actions">
        <a asp-action="Upload" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i> Upload log</a>
    </div>
</header>

@if (Model.Count == 0)
{
    <div class="lg-panel lg-empty">
        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
        <p>No log files yet. Upload an Apache / Nginx access log or a firewall log to start.</p>
        <a asp-action="Upload" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i> Upload log</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th>Status</th>
                    <th class="text-end">Parsed</th>
                    <th class="text-end">Failed</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>
                            <div class="lg-file-cell">
                                <span class="lg-icon lg-icon-sm @FileTint(f.Status)" aria-hidden="true"><i class="bi @FileIcon(f.Status)"></i></span>
                                <div>
                                    <a asp-action="Details" asp-route-id="@f.Id" class="fw-semibold">@f.FileName</a>
                                    @if (LogImport.FormatLabel(f) is { } formatLabel)
                                    {
                                        <div class="small text-body-secondary text-break">
                                            <i class="bi @FirewallFormat.SourceIcon(f.Source)" aria-hidden="true"></i> <span class="visually-hidden">@FirewallFormat.SourceLabel(f.Source):</span> @formatLabel
                                        </div>
                                    }
                                    @if (f.Status == LogFileStatus.Failed && f.ErrorMessage is not null)
                                    {
                                        <div class="lg-file-error">@f.ErrorMessage</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-nowrap">@Format.Bytes(f.SizeBytes)</td>
                        <td class="small">
                            <span class="text-nowrap">@f.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <div class="text-body-secondary">@f.UploaderDisplay</div>
                        </td>
                        <td>
                            <span class="badge @Format.StatusBadge(f.Status)">
                                @if (f.Status is LogFileStatus.Processing or LogFileStatus.Analyzing or LogFileStatus.Deleting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1 lg-nav-spinner" aria-hidden="true"></span>
                                }
                                @f.Status
                            </span>
                        </td>
                        <td class="text-end">@f.ParsedLines.ToString("N0")</td>
                        <td class="text-end @(f.FailedLines > 0 ? "text-warning" : "text-body-secondary")">@f.FailedLines.ToString("N0")</td>
                        <td class="text-end">
                            <div class="lg-row-actions">
                                <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                @if (isAdmin && !Format.IsBusy(f.Status))
                                {
                                    <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline js-confirm"
                                          data-confirm="Delete this log file and all its events?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete @f.FileName">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
