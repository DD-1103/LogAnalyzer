@{
    ViewData["Title"] = "Upload log";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-4">Upload log file</h1>

        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label for="file" class="form-label">Access log</label>
                        <input type="file" id="file" name="file" class="form-control" accept=".log,.txt,.gz" required />
                        <div class="form-text">
                            Apache or Nginx access logs in Common or Combined Log Format.
                            Allowed: .log, .txt, .gz (max 500 MB).
                        </div>
                    </div>

                    <div class="small text-body-secondary mb-4">
                        Expected line format:<br />
                        <code>192.168.1.10 - - [07/Nov/2026:20:15:32 +0100] "GET /index.html HTTP/1.1" 200 5120 "-" "Mozilla/5.0 ..."</code>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Upload</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
