@model List<DetectionRule>
@{
    ViewData["Title"] = "Detection rules";
    var counts = (Dictionary<int, int>)ViewBag.AlertCounts;
    var isAdmin = User.IsInRole(Roles.Admin);
    var source = (LogSource?)ViewBag.Source;
    int total = ViewBag.Total, enabled = ViewBag.Enabled, webCount = ViewBag.WebCount, firewallCount = ViewBag.FirewallCount;

    // Icon tile per rule kind
    static (string Icon, string Tint) KindStyle(RuleKind kind) => kind switch
    {
        RuleKind.Signature => ("bi-fingerprint", "lg-tint-indigo"),
        RuleKind.Threshold => ("bi-speedometer2", "lg-tint-orange"),
        RuleKind.DistinctCount => ("bi-diagram-3", "lg-tint-red"),
        _ => ("bi-stars", "lg-tint-teal")
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Detection rules</h1>
        <p class="lg-subtitle">
            @enabled of @total rules are on. Web rules run on access logs, firewall rules on firewall logs.
            Signature rules match single events, threshold rules count events per source, distinct-count rules
            count different ports or hosts (scans), and the anomaly rule learns what normal web traffic looks like.
        </p>
    </div>
    @if (isAdmin)
    {
        <div class="lg-actions">
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> New rule
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h2 class="dropdown-header">Web access logs</h2></li>
                    <li>
                        <a class="dropdown-item" asp-action="Create" asp-route-kind="Signature" asp-route-source="WebAccess">
                            <i class="bi bi-fingerprint" aria-hidden="true"></i> Signature: a pattern in one request
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="Create" asp-route-kind="Threshold" asp-route-source="WebAccess">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i> Threshold: many requests in a window
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="Create" asp-route-kind="Anomaly" asp-route-source="WebAccess">
                            <i class="bi bi-stars" aria-hidden="true"></i> Anomaly: Isolation Forest
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><h2 class="dropdown-header">Firewall logs</h2></li>
                    <li>
                        <a class="dropdown-item" asp-action="Create" asp-route-kind="Signature" asp-route-source="Firewall">
                            <i class="bi bi-fingerprint" aria-hidden="true"></i> Signature: a pattern in one event
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="Create" asp-route-kind="Threshold" asp-route-source="Firewall">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i> Threshold: many connections in a window
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-action="Create" asp-route-kind="DistinctCount" asp-route-source="Firewall">
                            <i class="bi bi-diagram-3" aria-hidden="true"></i> Distinct count: port scan / network sweep
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="lg-actions">
            <span class="lg-chip"><i class="bi bi-lock" aria-hidden="true"></i> Only administrators can change rules</span>
        </div>
    }
</header>

<nav class="lg-segmented mb-3" aria-label="Filter rules by log kind">
    <a asp-action="Index" class="@(source is null ? "active" : null)" aria-current="@(source is null ? "page" : null)">
        All <span class="lg-seg-count">@total</span>
    </a>
    <a asp-action="Index" asp-route-source="web" class="@(source == LogSource.WebAccess ? "active" : null)"
       aria-current="@(source == LogSource.WebAccess ? "page" : null)">
        <i class="bi bi-globe2" aria-hidden="true"></i> Web access <span class="lg-seg-count">@webCount</span>
    </a>
    <a asp-action="Index" asp-route-source="firewall" class="@(source == LogSource.Firewall ? "active" : null)"
       aria-current="@(source == LogSource.Firewall ? "page" : null)">
        <i class="bi bi-bricks" aria-hidden="true"></i> Firewall <span class="lg-seg-count">@firewallCount</span>
    </a>
</nav>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="lg-empty">
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <p>@(source switch
            {
                LogSource.Firewall => "There are no firewall rules yet.",
                LogSource.WebAccess => "There are no web access rules yet.",
                _ => "There are no detection rules yet."
            })</p>
            @if (isAdmin)
            {
                <a asp-action="Create" asp-route-source="@(source ?? LogSource.WebAccess)" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Create the first rule</a>
            }
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Rule</th>
                    <th scope="col">Severity</th>
                    <th scope="col">Logic</th>
                    <th scope="col" class="text-end">Alerts</th>
                    <th scope="col">Enabled</th>
                    @if (isAdmin) { <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var alertCount = counts.TryGetValue(r.Id, out var c) ? c : 0;
                    var (icon, tint) = KindStyle(r.Kind);
                    var (sourceIcon, sourceChip) = Format.SourceStyle(r.AppliesTo);
                    var firewall = r.AppliesTo == LogSource.Firewall;
                    <tr class="@(r.IsEnabled ? "" : "lg-row-off")">
                        <td>
                            <div class="d-flex align-items-start gap-3">
                                <span class="lg-icon lg-icon-sm @tint" title="@Format.KindLabel(r.Kind) rule"><i class="bi @icon" aria-hidden="true"></i></span>
                                <div class="min-w-0">
                                    <div class="fw-semibold">@r.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(r.Description))
                                    {
                                        <div class="small text-body-secondary">@r.Description</div>
                                    }
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <span class="lg-chip @sourceChip" title="Runs on @(firewall ? "firewall" : "web access") logs">
                                            <i class="bi @sourceIcon" aria-hidden="true"></i> @Format.SourceLabel(r.AppliesTo)
                                        </span>
                                        <span class="lg-chip">@Format.KindLabel(r.Kind)</span>
                                        <span class="lg-chip">@Format.AttackLabel(r.AttackType)</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge @Format.SeverityBadge(r.Severity)">@r.Severity</span></td>
                        <td class="small">
                            @switch (r.Kind)
                            {
                                case RuleKind.Signature:
                                    <div class="text-body-secondary mb-1">Regex on <strong class="text-body">@Format.FieldLabel(r.Field)</strong></div>
                                    <code class="text-break rule-pattern">@r.Pattern</code>
                                    break;
                                case RuleKind.Threshold:
                                    <div>At least <strong>@r.Threshold</strong> @(firewall ? "events" : "requests") from one IP in <strong>@r.WindowSeconds s</strong></div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @if (r.MethodFilter is not null) { <span class="lg-chip">method @r.MethodFilter</span> }
                                        @if (r.StatusFilter is not null) { <span class="lg-chip">status @r.StatusFilter</span> }
                                        @if (r.PathPattern is not null) { <span class="lg-chip">@(firewall ? "message" : "path") <code>@r.PathPattern</code></span> }
                                        @if (firewall && r.Pattern is not null) { <span class="lg-chip">@Format.FieldLabel(r.Field).ToLowerInvariant() <code>@r.Pattern</code></span> }
                                    </div>
                                    break;
                                case RuleKind.DistinctCount:
                                    <div>
                                        At least <strong>@r.Threshold</strong> different <strong>@Format.FieldLabel(r.Field)</strong>
                                        values from one IP in <strong>@r.WindowSeconds s</strong>
                                    </div>
                                    @if (r.Pattern is not null)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1"><span class="lg-chip">only <code>@r.Pattern</code></span></div>
                                    }
                                    break;
                                default:
                                    <div>Isolation Forest score at least <strong>@r.ScoreThreshold?.ToString("0.00")</strong></div>
                                    <div class="text-body-secondary">IPs with at least @r.Threshold requests, 11 behaviour features</div>
                                    break;
                            }
                            @if (firewall && (r.ActionFilter is not null || r.PortFilter is not null))
                            {
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @if (r.ActionFilter is not null) { <span class="lg-chip">action @r.ActionFilter.Replace(",", ", ")</span> }
                                    @if (r.PortFilter is not null) { <span class="lg-chip">port @r.PortFilter.Replace(",", ", ")</span> }
                                </div>
                            }
                        </td>
                        <td class="text-end">
                            @if (alertCount > 0)
                            {
                                <a asp-controller="Alerts" asp-action="Index" asp-route-attackType="@r.AttackType" class="badge text-bg-primary">@alertCount</a>
                            }
                            else
                            {
                                <span class="text-body-secondary">0</span>
                            }
                        </td>
                        <td>
                            @if (isAdmin)
                            {
                                <form asp-action="Toggle" asp-route-id="@r.Id" method="post" class="d-flex align-items-center gap-2">
                                    <button type="submit" class="lg-switch @(r.IsEnabled ? "is-on" : "")" role="switch"
                                            aria-checked="@(r.IsEnabled ? "true" : "false")"
                                            aria-label="@(r.IsEnabled ? "Turn off" : "Turn on") @r.Name"
                                            title="@(r.IsEnabled ? "On: click to turn off" : "Off: click to turn on")">
                                        <span class="lg-switch-knob" aria-hidden="true"></span>
                                    </button>
                                    <span class="small text-body-secondary">@(r.IsEnabled ? "On" : "Off")</span>
                                </form>
                            }
                            else
                            {
                                <span class="badge @(r.IsEnabled ? "text-bg-success" : "text-bg-secondary")">@(r.IsEnabled ? "On" : "Off")</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="Edit and test">
                                    <i class="bi bi-pencil" aria-hidden="true"></i><span class="visually-hidden">Edit @r.Name</span>
                                </a>
                                @if (alertCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline js-confirm"
                                          data-confirm="Delete rule '@r.Name'? This cannot be undone.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Delete @r.Name</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-body-secondary">
        Rules with alerts cannot be deleted, so their evidence stays traceable. Switch them off instead.
        Changes apply to new uploads; re-run detection on a log file to apply them to existing data.
    </p>
}
