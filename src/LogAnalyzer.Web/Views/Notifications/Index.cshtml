@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var anyRead = Model.Any(n => n.ReadAt is not null);
}

@section Head {
    <link rel="stylesheet" href="~/css/views-b.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Notifications</h1>
        <p class="lg-subtitle">Escalations, owners and verdicts that concern you. Seen notifications can be deleted.</p>
    </div>
    @if (anyRead)
    {
        <div class="lg-actions">
            <form asp-action="ClearRead" method="post" class="js-confirm" data-confirm="Delete all seen notifications?">
                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-trash" aria-hidden="true"></i> Clear all seen</button>
            </form>
        </div>
    }
</header>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="lg-empty">
            <i class="bi bi-bell" aria-hidden="true"></i>
            <p class="mb-0">No notifications. Escalations and verdicts that concern you appear here.</p>
        </div>
    </div>
}
else
{
    <ul class="lg-hub">
        @foreach (var n in Model)
        {
            <li class="lg-hub-row @(n.ReadAt is null ? "is-mine" : null)">
                <span class="lg-icon lg-icon-sm @(n.Kind == "escalation" ? "lg-tint-orange" : n.Kind == "verdict" ? "lg-tint-green" : "lg-tint-blue")" aria-hidden="true">
                    <i class="bi @(n.Kind switch { "escalation" => "bi-arrow-up-circle", "claim" => "bi-person-check", "verdict" => "bi-patch-check", "comment" => "bi-chat-left-text", _ => "bi-info-circle" })"></i>
                </span>
                <div class="lg-hub-main">
                    @if (SessionSlots.AppLink(Context.Request.PathBase, n.Link) is { } link)
                    {
                        <a href="@link" class="lg-hub-title">@n.Title</a>
                    }
                    else
                    {
                        <span class="lg-hub-title">@n.Title</span>
                    }
                    @if (n.Body is not null)
                    {
                        <p class="lg-hub-reason">@n.Body</p>
                    }
                    <div class="lg-hub-meta"><span>@Format.TimeAgo(n.CreatedAt)</span>@if (n.ReadAt is null) { <span class="badge text-bg-primary">New</span> }</div>
                </div>
                <div class="lg-hub-side">
                    @if (n.ReadAt is not null)
                    {
                        <form asp-action="Delete" asp-route-id="@n.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Delete notification: @n.Title"><i class="bi bi-x-lg" aria-hidden="true"></i> Delete</button>
                        </form>
                    }
                </div>
            </li>
        }
    </ul>
}
