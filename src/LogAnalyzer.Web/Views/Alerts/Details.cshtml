@model AlertDetailsViewModel
@using System.Globalization
@{
    var a = Model.Alert;
    ViewData["Title"] = a.Title;

    var sevTint = a.Severity switch
    {
        Severity.Critical => "lg-tint-red",
        Severity.High => "lg-tint-orange",
        Severity.Medium => "lg-tint-teal",
        _ => "lg-tint-gray"
    };
    var sevIcon = a.Severity switch
    {
        Severity.Critical => "bi-exclamation-octagon-fill",
        Severity.High => "bi-exclamation-triangle-fill",
        Severity.Medium => "bi-exclamation-circle-fill",
        _ => "bi-info-circle-fill"
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/views-b.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/views-c.css" asp-append-version="true" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Alerts</a></li>
        <li class="breadcrumb-item active" aria-current="page">#@a.Id</li>
    </ol>
</nav>

<header class="lg-page-header">
    <div class="lg-alert-hero">
        <span class="lg-icon lg-icon-lg @sevTint" aria-hidden="true"><i class="bi @sevIcon"></i></span>
        <div>
            <h1 class="lg-title text-break">@a.Title</h1>
            <div class="lg-hero-badges">
                <span class="badge @Format.SeverityBadge(a.Severity)">@a.Severity</span>
                <span class="badge @Format.AlertStatusBadge(a.Status)">@a.Status</span>
                <span class="lg-chip">@Format.AttackLabel(a.AttackType)</span>
            </div>
        </div>
    </div>
</header>

@if (a.OriginalSeverity is not null)
{
    <div class="alert alert-info lg-flash small" role="note">
        <i class="bi bi-arrow-down-circle-fill" aria-hidden="true"></i>
        <div>@a.SeverityNote</div>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100 lg-glow @sevTint">
            <div class="card-body">
                <h2 class="h6">Details</h2>
                <dl class="row lg-kv mb-0 mx-0">
                    <dt class="col-sm-4">Attack type</dt>
                    <dd class="col-sm-8">@Format.AttackLabel(a.AttackType)</dd>

                    <dt class="col-sm-4">Source IP</dt>
                    <dd class="col-sm-8">
                        <span class="font-monospace">@a.SourceIp</span>
                        <a asp-action="Index" asp-route-ip="@a.SourceIp" class="small ms-2">other alerts from this IP</a>
                    </dd>

                    <dt class="col-sm-4">Location / reputation</dt>
                    <dd class="col-sm-8">
                        @if (Model.IpInfo?.CountryCode is not null)
                        {
                            <span class="badge text-bg-secondary">@Model.IpInfo.CountryCode</span>
                            @(string.Join(", ", new[] { Model.IpInfo.City, Model.IpInfo.CountryName }.Where(x => !string.IsNullOrEmpty(x))))
                        }
                        else
                        {
                            <span class="text-body-secondary">Unknown</span>
                        }
                        @if (Model.IpInfo?.AbuseScore is int score)
                        {
                            <span class="badge @Format.AbuseBadge(score) ms-2" title="AbuseIPDB confidence score">AbuseIPDB @(score)%</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Rule</dt>
                    <dd class="col-sm-8">
                        @a.Rule?.Name
                        <div class="small text-body-secondary">@a.Rule?.Description</div>
                    </dd>

                    @if (a.Score is double anomalyScore)
                    {
                        <dt class="col-sm-4">Anomaly score</dt>
                        <dd class="col-sm-8">
                            <div class="lg-score">
                                <span class="lg-score-value">@anomalyScore.ToString("0.000")</span>
                                <progress class="lg-progress @(anomalyScore >= 0.7 ? "lg-tint-red" : "lg-tint-orange")" max="1"
                                          value="@Math.Clamp(anomalyScore, 0, 1).ToString("0.####", CultureInfo.InvariantCulture)"
                                          aria-label="Anomaly score">@anomalyScore.ToString("0.000")</progress>
                                <span class="badge @(anomalyScore >= 0.7 ? "text-bg-danger" : "text-bg-warning")">@(anomalyScore >= 0.7 ? "very unusual" : "unusual")</span>
                            </div>
                            <div class="small text-body-secondary mt-1">Isolation Forest (0.5 ≈ normal, 1 = most unusual)</div>
                            @if (!string.IsNullOrEmpty(a.Details))
                            {
                                <div class="lg-why">Why: @a.Details</div>
                            }
                        </dd>
                    }
                    else if (!string.IsNullOrEmpty(a.Details))
                    {
                        <dt class="col-sm-4">Why</dt>
                        <dd class="col-sm-8 text-break">@a.Details</dd>
                    }

                    <dt class="col-sm-4">Matching events</dt>
                    <dd class="col-sm-8 fw-semibold">@a.EventCount.ToString("N0")</dd>

                    <dt class="col-sm-4">First / last seen</dt>
                    <dd class="col-sm-8">
                        @a.FirstSeen.ToString("dd/MM/yyyy HH:mm:ss") to @a.LastSeen.ToString("dd/MM/yyyy HH:mm:ss")
                        <span class="text-body-secondary small">(@Format.Duration(a.LastSeen - a.FirstSeen))</span>
                    </dd>

                    <dt class="col-sm-4">Log file</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="LogFiles" asp-action="Details" asp-route-id="@a.LogFileId">@a.LogFile?.FileName</a>
                    </dd>

                    <dt class="col-sm-4">Assigned to</dt>
                    <dd class="col-sm-8">@(a.AssignedTo?.Email ?? "—")</dd>

                    @if (a.EscalatedAt is { } escalatedAt)
                    {
                        <dt class="col-sm-4">Escalated</dt>
                        <dd class="col-sm-8">
                            <span class="badge text-bg-info"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> SOC 2</span>
                            <span class="small text-body-secondary">by @a.EscalatedBy, @Format.TimeAgo(escalatedAt)</span>
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="lg-icon lg-icon-sm lg-tint-blue" aria-hidden="true"><i class="bi bi-person-check"></i></span>
                    <h2 class="h6 mb-0">Triage</h2>
                </div>
                @if (Model.AllowedStatuses.Count == 0)
                {
                    <p class="small text-body-secondary mb-3">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        @if (a.EscalatedAt is not null)
                        {
                            @(a.AssignedTo is null
                                ? "This alert is escalated to SOC 2. A SOC 2 analyst takes it from the hub; then only they change its status and verdict."
                                : $"This alert is owned by {NotificationService.DisplayName(a.AssignedTo)} (SOC 2). Only they change its status and verdict; add your opinion as a comment below.")
                        }
                        else
                        {
                            @($"This alert is {a.Status}. Only SOC 2 analysts or administrators can reopen or change it.")
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(a.Notes))
                    {
                        <div class="small lg-notes">@a.Notes</div>
                    }
                }
                else
                {
                    <form asp-action="Update" asp-route-id="@a.Id" method="post">
                        <div class="mb-3">
                            <label for="Status" class="form-label small">Status</label>
                            <select id="Status" name="Status" class="form-select">
                                @foreach (var s in Model.AllowedStatuses)
                                {
                                    if (a.Status == s) { <option value="@s" selected>@s</option> } else { <option value="@s">@s</option> }
                                }
                            </select>
                            @if (Model.Tier == AnalystTier.Soc1)
                            {
                                <div class="form-text">As SOC 1 you work on open alerts; closing is done by SOC 2.</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label for="Notes" class="form-label small">Analyst notes</label>
                            <textarea id="Notes" name="Notes" rows="5" maxlength="4000" class="form-control"
                                      placeholder="What did you find? Was the attack successful?">@a.Notes</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Save</button>
                    </form>
                }
                @if (Model.CanEscalate)
                {
                    <hr class="my-4" />
                    <form asp-action="Escalate" asp-route-id="@a.Id" method="post" class="js-confirm"
                          data-confirm="Escalate this alert to SOC 2? It stays open and goes to the SOC 2 queue.">
                        <label for="reason" class="form-label small">Escalate to SOC 2</label>
                        <div class="input-group">
                            <input id="reason" name="reason" class="form-control" maxlength="500" placeholder="Why? (optional)" />
                            <button type="submit" class="btn btn-outline-warning"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalate</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@if (a.EscalatedAt is { } escalatedOn)
{
    var ownerName = a.AssignedTo is null ? null : NotificationService.DisplayName(a.AssignedTo);
    var hereUrl = SessionSlots.CurrentUrl(Context.Request, includeQuery: false);
    <section class="lg-panel lg-escalation mb-4 @(a.Verdict is not null ? "is-decided" : null)" aria-labelledby="escalation-title">
        <div class="lg-escalation-head">
            <span class="lg-icon lg-tint-orange" aria-hidden="true"><i class="bi bi-arrow-up-circle"></i></span>
            <div class="min-w-0 flex-grow-1">
                <h2 id="escalation-title" class="h6 mb-0">Escalated to SOC 2</h2>
                <div class="small text-body-secondary">by @(a.EscalatedBy ?? "SOC 1"), @Format.TimeAgo(escalatedOn)</div>
            </div>
            <div class="lg-escalation-owner">
                @if (ownerName is not null)
                {
                    <span class="lg-owner @(Model.IsOwner ? "is-me" : null)">
                        <span class="lg-owner-avatar lg-icon lg-icon-sm lg-tint-indigo" aria-hidden="true">@string.Concat(ownerName.Split([' ', '.', '@'], StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])))</span>
                        <span class="lg-owner-name">@(Model.IsOwner ? "You own this" : $"Owned by {ownerName}")</span>
                    </span>
                }
                @if (Model.CanClaim)
                {
                    <form asp-action="Claim" asp-route-id="@a.Id" method="post">
                        <input type="hidden" name="returnUrl" value="@hereUrl" />
                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-hand-index-thumb" aria-hidden="true"></i> Take it</button>
                    </form>
                }
                @if (Model.CanRelease)
                {
                    <form asp-action="Release" asp-route-id="@a.Id" method="post" class="js-confirm"
                          data-confirm="@(Model.IsOwner ? "Give this escalation back to the SOC 2 queue?" : $"Take this escalation away from {ownerName} and put it back in the queue?")">
                        <input type="hidden" name="returnUrl" value="@hereUrl" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(Model.IsOwner ? "Give back" : "Release")</button>
                    </form>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(a.EscalationReason))
        {
            <blockquote class="lg-escalation-reason mb-0">@a.EscalationReason</blockquote>
        }

        @if (a.Verdict is { } verdict)
        {
            <div class="lg-verdict-result">
                <span class="lg-verdict lg-verdict-@verdict.ToString().ToLowerInvariant()"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> @SocPermissions.Label(verdict)</span>
                <span class="small text-body-secondary">by @a.VerdictBy@(a.VerdictAt is { } at ? ", " + Format.TimeAgo(at) : "")</span>
                <p class="small mb-0 mt-1">@SocPermissions.Describe(verdict)</p>
            </div>
        }

        @if (Model.CanGiveVerdict)
        {
            <form asp-action="Verdict" asp-route-id="@a.Id" method="post" class="lg-verdict-form">
                <fieldset>
                    <legend class="form-label small mb-2">@(a.Verdict is null ? "Your verdict" : "Change your verdict")</legend>
                    <div class="lg-verdict-options">
                        @foreach (var v in Enum.GetValues<EscalationVerdict>())
                        {
                            <label class="lg-verdict-option">
                                <input type="radio" name="verdict" value="@v" checked="@(a.Verdict == v)" required />
                                <span class="lg-verdict lg-verdict-@v.ToString().ToLowerInvariant()">@SocPermissions.Label(v)</span>
                                <span class="small text-body-secondary">@SocPermissions.Describe(v)</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <label for="verdict-note" class="form-label small mt-3">Why? (shown in the activity below)</label>
                <textarea id="verdict-note" name="note" rows="2" maxlength="1500" class="form-control" placeholder="What did you check, what did you find?"></textarea>
                <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-patch-check" aria-hidden="true"></i> Save verdict</button>
            </form>
        }
        else if (ownerName is not null && !Model.IsOwner)
        {
            <p class="small text-body-secondary mb-0">Only @ownerName can give or change the verdict. You can add a second opinion as a comment below.</p>
        }
    </section>
}

<section id="comments" class="mb-4" aria-labelledby="comments-title">
    <h2 id="comments-title" class="lg-section-title">Activity and comments <span class="lg-count">@Model.Comments.Count</span></h2>
    @if (Model.Comments.Count > 0)
    {
        <ol class="lg-timeline">
            @foreach (var c in Model.Comments)
            {
                var (cIcon, cTint) = c.Kind switch
                {
                    "escalation" => ("bi-arrow-up-circle", "lg-tint-orange"),
                    "claim" => ("bi-person-check", "lg-tint-indigo"),
                    "release" => ("bi-arrow-counterclockwise", "lg-tint-gray"),
                    "verdict" => ("bi-patch-check", "lg-tint-green"),
                    _ => ("bi-chat-left-text", "lg-tint-blue")
                };
                <li class="lg-timeline-item">
                    <span class="lg-icon lg-icon-sm @cTint" aria-hidden="true"><i class="bi @cIcon"></i></span>
                    <div class="min-w-0">
                        <div class="small"><span class="fw-semibold">@c.AuthorName</span> <span class="text-body-secondary" title="@c.CreatedAt.ToString("u")">@Format.TimeAgo(c.CreatedAt)</span></div>
                        <div class="lg-notes">@c.Text</div>
                    </div>
                </li>
            }
        </ol>
    }
    <form asp-action="Comment" asp-route-id="@a.Id" method="post" class="lg-comment-form">
        <label for="comment-text" class="form-label small">@(a.EscalatedAt is not null && !Model.IsOwner ? "Add a second opinion" : "Add a comment")</label>
        <textarea id="comment-text" name="text" rows="2" maxlength="2000" class="form-control" required
                  placeholder="Visible to every analyst on this alert"></textarea>
        <button type="submit" class="btn btn-sm btn-outline-primary mt-2"><i class="bi bi-send" aria-hidden="true"></i> Add comment</button>
    </form>
</section>

@{
    var isPublicIp = IpEnrichmentService.IsPublic(a.SourceIp);
    var returnUrl = SessionSlots.CurrentUrl(Context.Request, includeQuery: false);
}
@{
    var tiProviders = Model.Providers.Where(p => p.IsConfigured && p.Supports(IndicatorType.Ip)).ToList();
    var tiConsensus = LogAnalyzer.Web.Services.ThreatConsensus.Compute(
        Model.Reputation.Values.Where(r => tiProviders.Any(p => p.Name == r.Provider)));
}
<div class="lg-ti-header">
    <h2 class="lg-section-title">Threat intelligence</h2>
    @if (tiProviders.Count > 0)
    {
        <span class="lg-ti-pill tone-@Format.ConsensusTone(tiConsensus.Verdict)" title="@tiConsensus.Explanation">LogAnalyzer verdict: @tiConsensus.Label</span>
    }
    @* "1,234 other IPs" (merged alerts) is nothing to look up *@
    @if (System.Net.IPAddress.TryParse(a.SourceIp, out _))
    {
        <a asp-controller="ThreatIntel" asp-action="Lookup" asp-route-q="@a.SourceIp" class="small">full threat dashboard</a>
    }
    @if (isPublicIp && Model.Providers.Any(p => p.IsConfigured))
    {
        <form asp-controller="ThreatIntel" asp-action="Refresh" method="post" class="ms-auto">
            <input type="hidden" name="ip" value="@a.SourceIp" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh all providers</button>
        </form>
    }
</div>
<div class="row g-3 mb-4">
    @foreach (var p in tiProviders)
    {
        <div class="col-md-6 col-xl-4">
            <partial name="_ReputationCard" model="new ReputationCardModel(p, Model.Reputation.GetValueOrDefault(p.Name), a.SourceIp, isPublicIp, returnUrl)" />
        </div>
    }
    @if (tiProviders.Count == 0)
    {
        <div class="col-12">
            <div class="lg-not-checked small text-body-secondary">
                <i class="bi bi-info-circle" aria-hidden="true"></i> No threat-intel provider is configured.
                <a asp-controller="ThreatIntel" asp-action="Providers">Add an API key</a> to see what vendors know about this IP.
            </div>
        </div>
    }
</div>

<h2 class="lg-section-title">
    Evidence
    <span class="lg-count">@Model.EvidenceShown.ToString("N0") of @a.EventCount.ToString("N0") events shown</span>
</h2>
@if (a.LogFile?.Source == LogSource.Firewall)
{
    <partial name="_FirewallEvents" model="new FirewallEventsViewModel(Model.Evidence, a.LogFileId)" />
}
else
{
<div class="table-responsive">
    <table class="table table-sm table-hover small align-middle">
        <thead>
            <tr>
                <th>Line</th>
                <th>Time</th>
                <th>Method</th>
                <th>URL (decoded)</th>
                <th>Status</th>
                <th>User agent</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Evidence)
            {
                <tr>
                    <td class="text-body-secondary">@e.LineNumber</td>
                    <td class="text-nowrap">@e.Timestamp.ToString("dd/MM HH:mm:ss")</td>
                    <td>@e.Method</td>
                    <td class="font-monospace text-break url-cell" title="@e.Url">@LogAnalyzer.Web.Services.UrlDecoder.Decode(e.Url)</td>
                    <td class="@Format.HttpStatusClass(e.StatusCode) fw-semibold">@e.StatusCode</td>
                    <td class="text-body-secondary ua-cell" title="@e.UserAgent">@e.UserAgent</td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
