@model AlertListViewModel
@{
    ViewData["Title"] = "Alerts";
    var filtered = Model.Status.HasValue || Model.Severity.HasValue || Model.AttackType.HasValue
                   || !string.IsNullOrWhiteSpace(Model.Ip) || Model.LogFileId.HasValue;
}
@section Head {
    <link rel="stylesheet" href="~/css/views-b.css" asp-append-version="true" />
}

<header class="lg-page-header">
    <div>
        <h1 class="lg-title">Alerts</h1>
        <p class="lg-subtitle">
            @Model.TotalCount.ToString("N0") @(Model.TotalCount == 1 ? "alert" : "alerts")@(filtered ? " match these filters" : ""), open and most severe first.
        </p>
    </div>
    <div class="lg-actions">
        <a asp-action="Export" asp-route-status="@Model.Status" asp-route-severity="@Model.Severity"
           asp-route-attackType="@Model.AttackType" asp-route-ip="@Model.Ip" asp-route-logFileId="@Model.LogFileId"
           class="btn btn-sm btn-outline-success"><i class="bi bi-filetype-csv" aria-hidden="true"></i> Export CSV</a>
    </div>
</header>

<form method="get" asp-action="Index" class="lg-toolbar row g-2 align-items-end mx-0">
    @if (Model.LogFileId.HasValue)
    {
        <input type="hidden" name="logFileId" value="@Model.LogFileId" />
    }
    <div class="col-6 col-md-2">
        <label class="form-label small" for="status">Status</label>
        <select id="status" name="status" class="form-select form-select-sm">
            <option value="">All</option>
            @foreach (var v in Enum.GetValues<AlertStatus>())
            {
                if (Model.Status == v) { <option value="@v" selected>@v</option> } else { <option value="@v">@v</option> }
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small" for="severity">Severity</label>
        <select id="severity" name="severity" class="form-select form-select-sm">
            <option value="">All</option>
            @foreach (var v in Enum.GetValues<Severity>())
            {
                if (Model.Severity == v) { <option value="@v" selected>@v</option> } else { <option value="@v">@v</option> }
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small" for="attackType">Attack type</label>
        <select id="attackType" name="attackType" class="form-select form-select-sm">
            <option value="">All</option>
            @foreach (var v in Enum.GetValues<AttackType>())
            {
                if (Model.AttackType == v) { <option value="@v" selected>@v</option> } else { <option value="@v">@v</option> }
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small" for="ip">Source IP</label>
        <input id="ip" name="ip" value="@Model.Ip" class="form-control form-control-sm" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filter</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.LogFileId.HasValue)
{
    <p class="lg-filter-note">
        <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Showing alerts for one log file. <a asp-action="Index">Show all</a>
    </p>
}

@if (Model.Alerts.Count == 0)
{
    <div class="lg-panel lg-empty">
        <i class="bi bi-shield-check" aria-hidden="true"></i>
        <p class="mb-0">No alerts match these filters.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Severity</th>
                    <th>Alert</th>
                    <th>Attack type</th>
                    <th>Source IP</th>
                    <th class="text-end">Events</th>
                    <th>Last seen</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Alerts)
                {
                    var isNew = Model.IsNewSinceLastVisit(a);
                    <tr class="@(isNew ? "lg-row-new" : null)">
                        <td class="lg-sev-cell">
                            <span class="badge @Format.SeverityBadge(a.Severity)">@a.Severity</span>
                            @if (a.OriginalSeverity is not null)
                            {
                                <i class="bi bi-arrow-down-circle" title="@a.SeverityNote" aria-label="Severity lowered"></i>
                            }
                        </td>
                        <td>
                            @if (isNew)
                            {
                                <span class="lg-new-dot" title="New since your last visit"></span><span class="visually-hidden">New: </span>
                            }
                            <a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold">@a.Title</a>
                            <div class="small text-body-secondary">@a.LogFile?.FileName</div>
                        </td>
                        <td><span class="lg-chip">@Format.AttackLabel(a.AttackType)</span></td>
                        <td class="font-monospace">@a.SourceIp</td>
                        <td class="text-end">@a.EventCount.ToString("N0")</td>
                        <td class="small text-nowrap">@a.LastSeen.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td><span class="badge @Format.AlertStatusBadge(a.Status)">@a.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Alert pages">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-attackType="@Model.AttackType"
                       asp-route-ip="@Model.Ip" asp-route-logFileId="@Model.LogFileId">Previous</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       asp-route-status="@Model.Status" asp-route-severity="@Model.Severity" asp-route-attackType="@Model.AttackType"
                       asp-route-ip="@Model.Ip" asp-route-logFileId="@Model.LogFileId">Next</a>
                </li>
            </ul>
        </nav>
    }
}
