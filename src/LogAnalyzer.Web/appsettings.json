{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LogAnalyzerDb;Trusted_Connection=True;Encrypt=True;MultipleActiveResultSets=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
    }
  },
  "Enrichment": {
    "GeoLiteCityDb": "App_Data/GeoLite2-City.mmdb",
    "AbuseIpDbApiKey": "",
    "GreyNoiseApiKey": "",
    "VirusTotalApiKey": "",
    "GtiApiKey": "",
    "RecordedFutureApiKey": "",
    "OtxApiKey": "",
    "AbuseChAuthKey": "",
    "InternalDomains": [],
    "CacheDays": 7,
    "AbuseIpDbMaxPerRun": 200,
    "GreyNoiseMaxPerRun": 25,
    "VirusTotalMaxPerRun": 4,
    "VirusTotalMinIntervalSeconds": 15,
    "GreyNoiseDowngradeBenign": true,
    "AutoLookup": false,
    "RetentionDays": 90,
    "AbuseIpDbDailyBudget": 900,
    "GreyNoiseDailyBudget": 50,
    "VirusTotalDailyBudget": 450
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
